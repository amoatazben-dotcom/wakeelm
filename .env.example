APP_NAME=Telegram AI Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
TELEGRAM_BOT_TOKEN=replace-with-telegram-token
DATABASE_URL=postgresql://agent:local-password@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=generate-a-fernet-key
BOT_MODE=polling
BOT_DEFAULT_LANGUAGE=ar
LOG_LEVEL=INFO
# PUBLIC_BASE_URL=https://your-domain.example
# WEBHOOK_SECRET=generate-a-random-secret
