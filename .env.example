APP_NAME=Telegram AI Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
TELEGRAM_BOT_TOKEN=replace-with-telegram-token
DATABASE_URL=postgresql://agent:local-password@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
MASTER_ENCRYPTION_KEY=generate-a-fernet-key
BOT_MODE=polling
BOT_DEFAULT_LANGUAGE=ar
LOG_LEVEL=INFO
# PUBLIC_BASE_URL=https://your-domain.example
# WEBHOOK_SECRET=generate-a-random-secret

# Stages 3/4: attach a private persistent volume in production.
WORKSPACE_STORAGE_ROOT=storage/workspaces
MAX_UPLOAD_SIZE_MB=20
MAX_ARCHIVE_SIZE_MB=20
MAX_EXTRACTED_SIZE_MB=100
MAX_ARCHIVE_FILES=2000
MAX_SINGLE_FILE_SIZE_MB=5
MAX_PROJECT_FILES=2000
CONTEXT_MAX_TOKENS=6000
CONTEXT_SAFETY_MARGIN=0.2
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=20
MAX_REPLANS=2
MAX_REPAIR_ATTEMPTS=1
MAX_TASK_DURATION=300
MAX_COMMAND_OUTPUT_BYTES=32000
COMMAND_TIMEOUT=60
SANDBOX_BACKEND=disabled
SANDBOX_IMAGE=wakeelm-validation:local
REQUIRE_EDIT_APPROVAL=false
MAX_PATCH_FILES=10
APPROVAL_TTL_SECONDS=600

# Stages 5/6: optional integration setup; never commit real values.
# INTEGRATIONS_CALLBACK_BASE_URL=https://your-bot-domain.example
# GITHUB_APP_ID=12345
# GITHUB_APP_PRIVATE_KEY=configure-actual-multiline-pem-in-secret-ui
# GITHUB_CLIENT_ID=your-github-app-client-id
# GITHUB_CLIENT_SECRET=configure-in-secret-ui
# GITHUB_WEBHOOK_SECRET=generate-an-independent-random-secret
GITHUB_WRITE_ENABLED=false
GITHUB_PUSH_CI_REVIEWED=false
GITHUB_COMMENTS_ENABLED=false
GITHUB_BOT_NAME=Wakeelm Agent
GITHUB_BOT_EMAIL=wakeelm-agent@users.noreply.github.com
GIT_TIMEOUT_SECONDS=90
GIT_MAX_OUTPUT_BYTES=2000000
GIT_MAX_REPOSITORY_BYTES=100000000
GIT_MAX_MEMORY_MB=512
GIT_REQUIRE_VALIDATION=true
OAUTH_STATE_TTL_SECONDS=600
MCP_ALLOWED_TRANSPORTS=["streamable_http"]
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_CALL_TIMEOUT_SECONDS=30
MCP_MAX_RESPONSE_BYTES=1000000
MCP_MAX_CAPABILITIES=100
MCP_TOOL_POLICIES={}
MCP_OAUTH_CLIENTS={}
INTEGRATION_JOBS_ENABLED=true

# MCP_CALLBACK_BASE_URL=https://your-bot-domain.example  # alias of INTEGRATIONS_CALLBACK_BASE_URL
# Stage 7/8 routing and budgets
MAX_MODEL_FALLBACKS=2
MAX_JOB_MODEL_CALLS=12
MAX_JOB_TOKENS=100000
MAX_JOB_COST=1
GLOBAL_DAILY_COST_CAP=100
PROVIDER_DAILY_COST_CAP=50
MASTER_ENCRYPTION_PREVIOUS_KEYS=[]
# Admin is unavailable until all OIDC fields are set. No shared password.
# ADMIN_OIDC_ISSUER=https://identity.example
# ADMIN_OIDC_AUTHORIZE_URL=https://identity.example/authorize
# ADMIN_OIDC_TOKEN_URL=https://identity.example/token
# ADMIN_OIDC_JWKS_URL=https://identity.example/keys
# ADMIN_OIDC_CLIENT_ID=your-oidc-client
# ADMIN_OIDC_AUDIENCE=wakeelm-admin
# ADMIN_OIDC_CLIENT_SECRET=provision-in-Railway-only
ADMIN_REQUIRE_MFA=true
ADMIN_SESSION_SECONDS=900
ADMIN_SUPER_SUBJECTS=[]
AUDIT_RETENTION_DAYS=365
ARTIFACT_RETENTION_DAYS=30
MEMORY_RETENTION_DAYS=90
WORKSPACE_RETENTION_DAYS=30
BUILD_GIT_SHA=unknown
BUILD_TIMESTAMP=unknown
# BACKUP_ENCRYPTION_KEY is a separate Fernet key in the backup runner only.
